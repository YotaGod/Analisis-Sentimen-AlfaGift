at utuh menjadi bentuk daftar kata (list of strings), seperti kalimat \"halah gabisa kirim\" yang kini terpisah menjadi token ['halah', 'gabisa', 'kirim'] sehingga tiap unit kata siap dianalisis secara terpisah.","metadata":{}},{"cell_type":"markdown","source":"## Langkah 5.4: Normalisasi Slang","metadata":{}},{"cell_type":"code","source":"slang_df = pd.read_csv(SLANG_PATH, sep=';', header=None, names=['slang', 'formal'], skiprows=1)\nslang_df['slang'] = slang_df['slang'].astype(str).str.strip().str.lower()\nslang_df['formal'] = slang_df['formal'].astype(str).str.strip().str.lower()\nslang_dict = dict(zip(slang_df['slang'], slang_df['formal']))\n\ndef normalize_slang(tokens_list):\n    if not isinstance(tokens_list, list):\n        if isinstance(tokens_list, str):\n            tokens_list = word_tokenize(tokens_list)\n        else:\n            return [] \n    normalized = [slang_dict.get(word, word) for word in tokens_list]\n    return normalized \n\ndf['text_norm'] = df['tokens'].apply(normalize_slang)\n\nprint(\"Setelah Normalisasi Slang:\")\ndisplay(df[['tokens', 'text_norm']].head(10))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T10:33:25.476326Z","iopub.execute_input":"2026-09-07T10:33:25.476638Z","iopub.status.idle":"2026-09-07T10:33:25.608179Z","shell.execute_reply.started":"2026-09-07T10:33:25.4766Z","shell.execute_reply":"2026-09-07T10:33:25.607493Z"}},"outputs":[{"name":"stdout","text":"Setelah Normalisasi Slang:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                                              tokens  \\\n0  [gajelas, saya, pesen, udah, jam, belum, dikir...   \n1  [voucher, potongan, harga, di, aplikasi, hilan...   \n2                             [halah, gabisa, kirim]   \n3  [udah, langganan, padahal, tp, makin, kesini, ...   \n4           [pesanan, tidak, sesuai, dan, dikorupsi]   \n5  [pelayanan, ok, bang, ngga, ada, barang, minta...   \n6  [untuk, cs, alfagift, lama, bgt, pesanan, 