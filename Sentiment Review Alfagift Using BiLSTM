word]\n    elif word in neg_dict: return neg_dict[word]\n    else:\n        synsets = wn.synsets(word, lang='ind')\n        for syn in synsets:\n            lemmas = [l.name() for l in syn.lemmas(lang='ind')]\n            for lemma in lemmas:\n                if lemma in pos_dict: return 1\n                elif lemma in neg_dict: return -1\n    return 0\n\ndef get_sentiment(text):\n    if not isinstance(text, str) or text.strip() == \"\":\n        return 'Negatif'\n    score = 0\n    words = text.split()\n    negation_words = ['tidak', 'gak', 'ga', 'nggak', 'kurang', 'bukan', 'jangan', 'belom', 'belum']\n\n    for word in words:\n        if \"_\" in word:\n            parts = word.split(\"_\")\n            if parts[0] in negation_words:\n                base_score = get_score(parts[1])\n                if base_score != 0:\n                    score += (base_score * -1) \n        else:\n            score += get_score(word)\n\n    return 'Positif' if score > 0 else 'Negatif'\n\nprint(\"Sedang melakukan labeling sentimen...\")\ndf['label'] = df['text_final'].apply(lambda x: get_sentiment(' '.join(x)) if isinstance(x, list) else get_sentiment(x))\n\nprint(\"\\nDistribusi Label:\")\nprint(df['label'].value_counts())\n\nprint(\"\\nContoh hasil labeling:\")\ndisplay(df[['text_final', 'label']].head(5))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-09-07T11:56:54.413142Z","iopub.execute_input":"2026-09-07T11:56:54.413508Z","iopub.status.idle":"2026-09-07T11:56:59.799384Z","shell.execute_reply.started":"2026-09-07T11:56:54.41348Z","shell.execute_reply":"2026-09-07T11:56:59.798599Z"}},"outputs":[{"name":"stdout","text":"Sedang melakukan labeling sentimen...\n\nDistribusi Label:\nlabel\nPositif    41842\nNegatif     8158\nName: count, dtype: int64\n\nContoh hasil labeling:\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                                          text_final    label\n0  [gajelas, sen, jam, belum_kirim, chat, ad